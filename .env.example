# ============================================================
#  千年影戏 · 服务端环境变量
#  用法：复制为 .env（或直接 export），真实值不要提交到仓库
# ============================================================

# ---------- 服务本身 ----------
PORT=3100                     # server.js 监听端口（线上由 nginx 反代到 /api/）
QN_ORIGIN=                    # 允许跨域的来源，留空表示仅同源
DEV_PORT=8092                 # 本地开发服端口（server/dev.js）

# ---------- 数据与上传 ----------
# QN_DATA=                    # 数据目录，默认 server/data
# QN_UPLOAD=                  # AI 出图目录，默认 ../uploads/ai

# ---------- 大模型：DeepSeek（影窗问答、说戏人、影偶生成）----------
# 优先级：环境变量 > server/config/deepseek.json > /etc/qnyx/deepseek.json
QN_DEEPSEEK_KEY=
QN_DEEPSEEK_MODEL=deepseek-chat
# QN_DEEPSEEK_MODE=mock       # 无 Key 时用内置假回答跑通流程
# QN_DEEPSEEK_CONFIG=/etc/qnyx/deepseek.json

# ---------- 大模型：智谱 CogView（影偶上色出图）----------
QN_ZHIPU_KEY=
QN_ZHIPU_MODEL=cogview-3-flash
# QN_ZHIPU_MODE=mock
# QN_ZHIPU_CONFIG=/etc/qnyx/zhipu.json

# ---------- 邮件（注册验证码）----------
# QN_MAIL_MODE=log            # 本地开发：验证码打到 server/data/mail.log
# QN_MAIL_CONFIG=/etc/qnyx/mail.json
